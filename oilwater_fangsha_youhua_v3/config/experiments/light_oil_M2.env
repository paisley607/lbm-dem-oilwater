# ★★ 2026-10-25 新增：稀油对照（μ_o=2 mPa·s，粘度比 M≈2），N=40。
#   用途：与 M≈20 的结果对比粘度比效应；计算量是 M≈20 的 1/10。
#   代价（plan_run.py，N=40、τ_w=0.7）：约 94 万步/PV，5 PV 约 520 万步；
#   按每核 0.5 MLU/s 粗估 64 核约 35 天、256 核约 9 天——先用冒烟测试实测速度再决定。
#   用法：CONFIG_FILE=config/experiments/light_oil_M2.env bash run_production.sh
BASE_CONFIG=../production.env
EXPERIMENT_NAME=oilwater_light_oil_M2
MU_O=2.0e-3
# M≈2 时满足 Δρ≤0.2 的最大速度 4.55e-4 m/s
V_INF=4.5e-4
MAX_T=8.6
VTK_INTERVAL_S=0.4
PARTICLE_DUMP_INTERVAL_S=0.02
