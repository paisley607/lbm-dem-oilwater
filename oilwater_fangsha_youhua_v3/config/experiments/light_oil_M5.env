# ★★ 2026-10-25 新增：中等粘度油（μ_o=5 mPa·s，粘度比 M≈5），N=40。
#   代价（plan_run.py，N=40、τ_w=0.7）：约 235 万步/PV，5 PV 约 1290 万步；按每核 0.5 MLU/s 粗估 64 核约 87 天。
#   用法：CONFIG_FILE=config/experiments/light_oil_M5.env bash run_production.sh
BASE_CONFIG=../production.env
EXPERIMENT_NAME=oilwater_light_oil_M5
MU_O=5.0e-3
# M≈5 时满足 Δρ≤0.2 的最大速度 1.82e-4 m/s
V_INF=1.8e-4
MAX_T=21.5
VTK_INTERVAL_S=1.0
PARTICLE_DUMP_INTERVAL_S=0.04
