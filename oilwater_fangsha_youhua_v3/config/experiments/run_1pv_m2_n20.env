# 超算 64 核跑 1 PV（N=20, M≈2, μ_o=2 mPa·s）——约 2-3 小时
# 基于 quick_light_oil_N20，只把 TOTAL_PV 从 5 改成 1
BASE_CONFIG=quick_light_oil_N20.env
EXPERIMENT_NAME=oilwater_1pv_m2_n20_v2
TOTAL_PV=1
MAX_T=7.2
RAMP_TIME=0.5
IBM_FORCE_ABORT_N=1.0
PV_SAMPLES=0.1,0.5,1
VTK_INTERVAL_S=0.3
LOG_INTERVAL_S=0.05
PARTICLE_DUMP_INTERVAL_S=0.05
