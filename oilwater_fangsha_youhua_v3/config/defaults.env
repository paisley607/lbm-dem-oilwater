# ============================================================================
# oilwater_fangsha_youhua — 全部参数总表（逐行注释版）
# ----------------------------------------------------------------------------
# 说明：
#   - 所有物理量用国际单位制（SI），单位写在参数名的后缀里（_M=米，_PA=帕，_S=秒...）
#   - 你 90% 的时间只需要改标了 ★ 的参数
#   - 不确定某个参数是干嘛的，看它上面那行注释就行
#   - 三层优先级：命令行环境变量 > 实验 .env 文件 > 本文件（defaults.env）
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# 第 1 段：运行模式与输出路径（一般不用改）
# ────────────────────────────────────────────────────────────────────────────

# 运行模式：production=正式跑模拟；calibration=只算单相渗透率做标定；test=快速测试
RUN_MODE=production

# 测试剖面名（RUN_MODE=test 时用，正式跑不用管）
TEST_PROFILE=production

# 标定模式开关：0=正常两相跑；1=只跑单相水测渗透率（自动停在1PV）
CALIBRATION_MODE=0

# 实验名称标签（会写进输出文件名，方便区分不同组实验）
EXPERIMENT_NAME=

# 继承的基础配置文件路径（实验文件里用，比如 BASE_CONFIG=defaults.env）
BASE_CONFIG=

# 本次运行的自定义名称（留空自动生成）
RUN_NAME=

# 自定义输出目录（留空自动在 OUTPUT_ROOT 下建）
OUTDIR=

# 集群上的输出根目录（改成你自己的路径）
OUTPUT_ROOT=/public3/home/sc52079/LBDEM_runs

# 输出文件名前缀（留空用默认）
OUTPUT_PREFIX=

# ── 参考岩心数据（Tang2024 文献里的岩心参数，只用于对比和校验，不影响模拟）──
# 参考样品名称
REFERENCE_SAMPLE=Tang2024_core_I
# 参考岩心长度 [mm]
REFERENCE_CORE_LENGTH_MM=50.31
# 参考岩心直径 [mm]
REFERENCE_CORE_DIAMETER_MM=25.28
# 参考岩心孔隙度
REFERENCE_CORE_POROSITY=0.365
# 参考岩心渗透率 [mD，毫达西]
REFERENCE_CORE_PERMEABILITY_MD=3542

# ── 并行与编译 ──
# MPI 进程数（跑的时候用几个核，一般=节点核数）
# ★★ 2026-10-25 修改：4 → 64。N=40 时有 1840 万格点 × 2 套格子，4 核大约要 16 倍于 64 核的时间。
#   amd_256 分区每个节点有几个核请先用  sinfo -p amd_256 -o "%n %c"  查一下，NP 和 submit.sh 里的 -n 都改成它。
NP=64
# 编译时并行 job 数（make -j 几）
BUILD_JOBS=6


# ────────────────────────────────────────────────────────────────────────────
# 第 2 段：LBM 网格、流体、时间步长、计算域几何
# ────────────────────────────────────────────────────────────────────────────

# ★ 网格分辨率：一个"参考直径"REFERENCE_DIAMETER_UM（200 μm）切成 N 格。
#   ★★ 2026-10-25 更正注释：N=40 → 格距 Δx = 200/40 = 5 μm；整个域 2.3×1×1 mm 是 460×200×200 ≈ 1840 万格。
#   细粒 50 μm = 10 格/直径（审稿一般要求 ≥20 格，需 N=80）。
#   增大 N：每步格点数 ∝ N³；但"每注 1 PV 要多少步"与 N 无关（见 修改说明_20261025.md 第 3 问）。
N=40

# 参考颗粒直径 [μm]。格距 Δx = REFERENCE_DIAMETER_UM / N（N=40 时 5 μm，200 μm 的颗粒占 40 格）。
REFERENCE_DIAMETER_UM=200

# ★ 计算域几何尺寸 [m]：x方向长 2.3 mm，y/z 方向各 1.0 mm
#   这是一个微型岩心模型，不是真实岩心尺度
DOMAIN_LX_M=2.3e-3
DOMAIN_LY_M=1.0e-3
DOMAIN_LZ_M=1.0e-3

# 岩心（颗粒堆积区）的 x 方向起止位置 [m]：从 0.1 mm 到 2.10 mm
#   两端各留了一小段空白做入口和出口缓冲区
CORE_X0_M=1.0e-4
CORE_X1_M=2.10e-3

# DEM 盒子的 x 上限 [m]：比流体域多出一点"删除缓冲带"，
#   让产出颗粒越过流体出口后还有空间被程序安全删掉，不会报错
DEM_BOX_XHI_M=2.31e-3

# ★ LBM 格子速度上限 [格子单位]。
#   注意：TAU_W_TARGET>0 时程序会自动反算 uMax 来保证 τ_w 等于目标值，这个值实际上不起作用（只要求 >0）。
UMAX=0.003

# 流体（水）密度 [kg/m³]，真实水是 1000
RHO_F=1000

# ★ 水相动力粘度 [Pa·s]。1.01e-3 = 1.01 mPa·s，接近常温清水
MU_F=1.01e-3

# ★ 驱替入口速度 [m/s]（达西速度）。
#   ★★ 2026-10-25 修改：0.0015 → 4.5e-5。这是 N=40、τ_w=0.7、M≈20 时能通过压差预检（Δρ≤0.2）的最大值：
#     岩心一开始充满油，达西压差 Δp = V·μ_o·L/k ≈ 600 Pa，折成格子密度差 0.198。
#     你原来的 0.0015 在岩心充满油时 Δρ≈6.6（τ_w=0.7）或 15（τ_w=0.8），物理上不成立。
#   改 N、TAU_W_TARGET、MU_O 后这个上限会变，请先运行  python3 plan_run.py  查看。
V_INF=4.5e-5

# ★ 总模拟物理时间 [s]。配合 TOTAL_PV 看：注多少孔隙体积算完。
#   ★★ 2026-10-25 修改：1.00 → 86。它只是"最多算多久"，必须 ≥ 注完 TOTAL_PV 所需时间 × 安全系数，
#     否则启动时报 [FATAL] MAX_T 不够（你的"错误 7"就是这个）。
#     V_INF=4.5e-5 时注 1 PV ≈ 15.5 s（≈940 万步），5 PV 需 ≥ 85.2 s。plan_run.py 会算出这个值。
MAX_T=86

# 粘度缩放系数（一般=1，不用动）
NU_SCALE=1

# DEM 时间步长 [s]。8e-8 秒 = 80 纳秒。DEM 步长必须比 LBM 小很多，
#   因为颗粒碰撞要更细的时间分辨率。每 N 个 LBM 步跑一个 DEM 步。
DT_DEM=8e-8

# ★ 总驱替孔隙体积 PV（pore volume）。10 PV = 把岩心孔隙体积的 10 倍流体注进去。
#   水驱油一般 5~10 PV 就基本采完了。
#   ★★ 2026-10-25 提醒：每注 1 PV 的步数 ≈ 3·φ·(L²/k)·ν_lb,w·M / Δρ_max，当前设置约 940 万步/PV，
#     N=40 时 5 PV 约 5200 万步——按每核 0.5 MLU/s、64 核粗估要一年，实际上算不完。
#     请先跑冒烟测试（config/test_1pv.env）实测速度，再用 plan_run.py 和 修改说明_20261025.md 第 5 节
#     决定粘度比、PV 数、N 和核数（例如 config/experiments/quick_light_oil_N20.env 约 4 天）。
TOTAL_PV=5

# 缓启动时间 [s]：前 0.05 秒把流速从 0 线性升到目标值，避免一开就冲产生数值冲击
RAMP_TIME=0.05

# 预平衡时间 [s]：先不驱替，让流场自己稳定 2.5 ms，再开始正式驱替
EQUILIBRATION_TIME_S=0.0025

# 出口切换到"自由出流"的时间点 [PV]。0=从一开始就是自由出口。
OPEN_OUTLET_PV=0

# 颗粒包文件路径（二进制文件，存了所有颗粒的位置/半径/类型）
PACK_FILE=data/oilwater_fangsha.porepack

# ── ★ 标定阶段的渗透率/孔隙度合格范围 [mD]：程序启动时会算一下单相渗透率，
#    如果不在 3000~4100 mD 之间会报警（说明颗粒包几何有问题）──
K_MIN_MD=3000
K_MAX_MD=4100
# 孔隙度合格范围（这是颗粒包在当前网格上离散后的岩心孔隙度；N=40 实测 0.3476，略低于 0.35）
#   ★★ 2026-10-25 说明：你把 0.35 改成 0.32 是对的（错误 1 只是离散误差，不是几何坏了），0.34 也够用。
PHI_MIN=0.32
PHI_MAX=0.38


# ============================================================================
# ★★★ 第 3 段：油–水两相（Shan-Chen 多组分）核心参数 ★★★
# ----------------------------------------------------------------------------
# 这一段是两相模型的核心，你做参数扫描主要改这里。
# 物理模型：油、水各一套分布函数，两相之间加排斥力 G 形成油水界面。
# 建议先跑 validation/ 里的 numpy 小脚本试参数，再上集群。
# ============================================================================

# 油相真实密度 [kg/m³]。只用于 ①算油的运动粘度 ②启动时打印 Bond 数。
#   注意：格子里油水密度都取 1（消除伪压力），这个物理密度只做单位换算用。
RHO_O=800

# ★ 油相动力粘度 [Pa·s]。这是你研究的核心变量！
#   粘度比 M = MU_O / MU_F = 油粘度 / 水粘度。
#   - 稀油：M≈5（油 5 mPa·s）
#   - 稠油：M=50~300（油 50~300 mPa·s）
#   默认 20 mPa·s（M≈20）。M 越大油越粘，τ_o 越大、计算越不稳，逐级加。
#   ★★ 2026-10-25 提醒：M 直接决定计算量——每注 1 PV 的步数与 M 成正比（岩心充满油时压差最大）。
#     τ_w=0.7 时：M=2 约 93 万步/PV，M=5 约 232 万，M=20 约 930 万。见 修改说明_20261025.md 的代价表。
#     M>9 必须配合 MIXTURE_TAU=1（旧的固定 τ 做法会发散）。
MU_O=20.0e-3

# ★ Shan-Chen 跨组分排斥强度 G。控制油水界面张力大小：
#   G 越大 → 界面张力越大 → 油水越不容易互相混溶
#   验证结果：G=2.0 太弱（互溶10%）；G=2.5 最佳（互溶4.5%）；G=3.0 也可以；G=3.5 发散炸掉
SHAN_CHEN_G=2.5

# 另一相的残余密度 [格子单位]。避免某相密度算到 0 导致除零错误。
#   0.005 = 注入相占 99.5%，被驱相占 0.5% 作为背景。
RHO_RESIDUAL=0.005

# 初始状态：岩心里一开始满的是什么相。
#   oil = 岩心里全是油，然后用水去驱（水驱油，常规场景）
INITIAL_CONTINUOUS_PHASE=oil

# 注入相：从入口注进去的是什么。water = 注水驱油
INJECT_PHASE=water

# 初始油水界面的位置 [m]。默认就在岩心入口处（x=0.1mm）
INITIAL_FRONT_POSITION_M=1.0e-4

# ★ 初始界面的平滑过渡宽度 [格]（tanh 半宽）。原版是 1 格硬阶跃，一开就冲击。
#   ★★ 2026-10-26：改为 2（接近 G=2.5 时 Shan-Chen 平衡界面的实际宽度）。过渡区的总密度现在按
#   "压力处处相等"自动给出（见主程序注释）；过渡区太宽反而会在里面自发分相、搅起局部流动。0=硬阶跃。
INITIAL_FRONT_WIDTH_CELLS=2

# ★ 水相松弛时间 τ_w。τ 决定流体粘度：ν=(τ-0.5)/3。
#   τ 越接近 0.5 粘度越小、数值越不稳定。程序自动反算 uMax 来凑这个 τ（两相版本必须 >0.5，不再支持 0）。
#   ★★ 2026-10-25 修改：0.8 → 0.7。
#     原因：每注 1 PV 的步数 ∝ (τ_w − 0.5)，0.7 比 0.8 少 1/3；同样流速下 Δρ ∝ (τ_w − 0.5)²，小一半多。
#     numpy 验证（MIXTURE_TAU=1，M≈25）：τ_w=0.7 的分层流、静止液滴（R=8~18 格）、壁面接触角都稳定；
#     τ_w=0.6 时小液滴和接触角算例发散，τ_w=0.55 连分层流都发散。所以 0.7 是推荐下限。
#     如果冒烟测试出现 [ERROR] 流场失稳，改回 0.8（代价再增加 50%）。
TAU_W_TARGET=0.7

# ★★ 2026-10-25 新增：局部混合松弛时间（1=开，推荐；0=旧做法：水、油格子各用固定 τ）。
#   旧做法在有壁面时 τ_o ≥ 4.5（τ_w=0.8 时 M≳10）20 步内发散，你设的 M=20（τ_o≈7.9）用旧做法必炸；
#   而且水里溶进的油会让水"变稠"。新做法：每个格点按局部含水比例 s=ρ_w/(ρ_w+ρ_o)
#   算一个混合粘度，两套格子用同一个 τ：纯水区用 τ_w，纯油区用 τ_o，界面处调和平均。
MIXTURE_TAU=1
# 含水比例低于 MIX_SAT_LOW 按纯油粘度、高于 MIX_SAT_HIGH 按纯水粘度，中间调和平均。一般不用改。
MIX_SAT_LOW=0.05
MIX_SAT_HIGH=0.95
# ★★ 2026-10-25 新增：痕量组分"偏离公共速度"的上限（格子单位）。只是防止界面/壁面旁只有残余密度的
#   那个组分速度失控的保护阀，一般不用改。旧版把整个速度都缩放，会让油水界面变成"无滑移墙"（已修正）。
TRACE_VELOCITY_CAP=0.3
# ★★ 2026-10-26 新增：油水两相之间"动量交换"的松弛时间 τ_D（格子单位），默认 1.0，一般不用改。
#   旧版直接用粘性 τ：油区 τ≈5.45 时，界面处残余组分的速度被放大 5 倍、经常被上面的保护阀削掉，
#   削掉的动量不守恒，相当于在油水界面上凭空加了一个"泵"（一维平界面验证：两侧压差 0.019、
#   整体漂移 0.012 格子单位，是注入速度的上千倍）。改成统一的 τ_D=1 后两相动量严格守恒，
#   粘度比照旧由上面的混合 τ 决定。0 = 旧做法（只做对比用）。
DIFFUSION_TAU=1.0
# ★★ 2026-10-26 新增：固含率超过这个值的格点，在油水两相作用（Shan-Chen 力、润湿）里一律当"固体"，默认 0.5，一般不用改。
#   旧版只把"完全被颗粒覆盖"（>0.999）的格点当固体，固含率 0.9、0.99 的格点照样施加两相力，
#   在细粒和骨架相切的楔形缝里与 PSM 反弹互相打架，本机测试剖面第 2159 步在这种切点处发散。
#   0.5 相当于把颗粒表面取在"一半被覆盖"的位置（PSM 的常用约定）。
SHAN_CHEN_SOLID_THRESHOLD=0.5

# ★★ 润湿性参数（你做油湿vs水湿对比实验的核心！）★★
# 2026-10-26 起直接给"接触角"（单位：度，从水相一侧量）：
#   < 90° = 水湿（水在颗粒表面铺开），90° = 中性，> 90° = 油湿（水在颗粒表面缩成水珠）。
#   可用范围 20°～160°。典型取值：强水湿 30～45，弱水湿 60～75，中性 90，弱油湿 105～120，强油湿 135～150。
# 为什么改：旧参数 WALL_WATER_FRACTION（"含水比例" s_wall）对应的"虚拟密度"写法会在整个颗粒表面推挤流体，
#   窄喉道里流体被压缩，s≤0.3（油湿）和 s≥0.6（水湿）在 numpy 多孔介质算例里都发散；
#   本机测试第 7 步发散也与此有关。现在改用文献中的"几何接触角"做法（Ding & Spelt 2007；Li 等 2014），
#   只在油水界面碰到颗粒的地方（接触线）起作用，本体流体不受壁面力。
#   numpy 验证（validation/v3_contact_angle.py，τ_w=0.7、τ_o=5.45 即 M≈20，WETTING_GAIN=2.4）：
#     输入 30° → 实测 25°，60° → 58°，90° → 88°，120° → 118°；
#     二维多孔介质（喉道 1–4 格）在 30° 和 150° 下 3000 步均稳定。
# 三类颗粒：type1=骨架颗粒，type2=可动细粒，type3=出口筛网
WALL_CONTACT_ANGLE_DEG_TYPE1=90
WALL_CONTACT_ANGLE_DEG_TYPE2=90
WALL_CONTACT_ANGLE_DEG_TYPE3=90
# 计算域四个侧壁（y、z 方向的反弹壁）的接触角。侧壁只是模型的方形外壳，不代表岩石，默认 90（中性）。
#   （旧版程序把侧壁误当成"油、水密度都是 1"的流体，同时排斥两相，是本机测试第 7 步发散的主要原因之一。）
CONTAINER_WALL_CONTACT_ANGLE_DEG=90
# 接触角外推系数（标定值）。几何接触角公式离散到格子上会"打折扣"（不乘系数时 60° 实测为 76°），
#   用 numpy 液滴算例标定为 2.4 后输入角≈实测角。一般不用改；若你用 validation/v3_contact_angle.py
#   在自己的 τ、G 下重新标定，把新值填在这里。
WETTING_GAIN=2.4

# ★ 毛细反作用力是否传给颗粒。1=传（新版，物理正确）；0=不传（老版行为，做对比用）。
#   什么是毛细反作用力？油水界面在颗粒表面弯曲时，会对颗粒产生一个额外的力。
#   原版只算了流体这边的力，没反作用到颗粒上，等于漏了一个重要的力。
CAPILLARY_FORCE_ON_PARTICLES=1

# ★ 入口控制方式：
#   flow     = 恒流量驱替（入口速度固定 = V_INF）
#   pressure = 恒压差驱替（入口压力固定 = INLET_PRESSURE_PA，流量随岩心堵塞自动变）
INLET_CONTROL=flow

# 恒压模式下的入口压差 [Pa]。
#   ★★ 2026-10-25 修改：20000 → 600。N=40、τ_w=0.7 时 1 个格子密度单位 = 3060 Pa，
#     Δρ≤0.2 对应入口压差 ≤ 612 Pa（旧值 20000 Pa 对应 Δρ≈6.5）。改 N 或 τ_w 后按 plan_run.py 重算。
INLET_PRESSURE_PA=600

# ★ 驱动协议：
#   continuous    = 缓启动后一直驱替到底（常规水驱油）
#   stop_restart  = 注到 STOP_AT_PV 就停，停 HOLD_TIME_S 时间，再分级提速重启
#                   （模拟"关井再开井"观察重启动出砂现象）
DRIVE_PROTOCOL=continuous

# stop_restart 协议：注到几个 PV 时停注
STOP_AT_PV=3

# stop_restart 协议：停注后关井静止多久 [秒]
HOLD_TIME_S=0.02

# stop_restart 协议：重启时分几级台阶升流量（比如 5 级：10%→20%→...→100%）
RESTART_STAGES=5

# stop_restart 协议：每级台阶保持多久 [秒]
RESTART_STAGE_HOLD_S=0.02

# stop_restart 协议：最后一级升到原流量的几倍（2.0 = 冲到原来 2 倍流速）
RESTART_MAX_FACTOR=2.0

# 细粒速度上限（按格子马赫数自动算）。DEM_MAX_PARTICLE_SPEED_M_S=0 时启用。
#   上限 = PARTICLE_MACH_LIMIT × Δx/Δt（N=20 时 Δx/Δt≈1.5 m/s）。
#   ★★ 2026-10-26：由 0.3 改为 0.05。PSM（部分饱和法）要求颗粒在一个格子步里移动远小于 1 格，
#     颗粒速度 0.3 格/步时颗粒周围的平衡分布严重失真；本机测试剖面第 1739 步发散就是因为一个脱胶的细粒
#     在油水界面上被毛细力（约 2e-6 N，比它受的粘性阻力大 1–2 个数量级）在几十步内加速到 0.3 格/步
#     （0.45 m/s）。0.05 格/步（N=20 时约 0.076 m/s）仍比孔隙流速（约 3e-5 m/s）大三个数量级以上，
#     不会截断任何有物理意义的细粒运移。
PARTICLE_MACH_LIMIT=0.05

# 由 validation/v2_laplace.py 标定出来的格子界面张力值。
#   只用于启动时算毛细数 Ca 做报告用，不参与实际计算。换了 G 要重新标定！
#   ★★ 2026-10-25：0.085 是旧算法的标定值；新算法（MIXTURE_TAU=1）下液滴会部分溶进油里，
#     v2_laplace.py 只能粗估 0.09–0.15。写论文前请用 TW/TO 环境变量按实际 τ 重新标定。
SIGMA_LB_CALIBRATED=0.085

# 真实世界的油水界面张力 [N/m]。0.025 N/m = 25 mN/m，典型油水界面张力。
#   只用于算真实毛细数 Ca_real 和 Bond 数，做方法节对比用。
SIGMA_PHYS_REFERENCE_N_M=0.025


# ────────────────────────────────────────────────────────────────────────────
# 第 4 段：采样输出与数值稳定性保护（一般不用改）
# ────────────────────────────────────────────────────────────────────────────

# 在哪些 PV 点做重点采样（逗号分隔）
PV_SAMPLES=1,5,10

# 每隔多久写一次 VTK 可视化文件 [秒]（用 ParaView 打开看流场）
#   ★★ 2026-10-25 修改：0.25 → 4.0。现在注 1 PV 约 15 s；N=40 时每个 VTK 约 0.6 GB，0.25 s 一个会写出上百 GB。
VTK_INTERVAL_S=4.0

# 每隔多久 dump 一次颗粒位置/状态 [秒]
#   ★★ 2026-10-25 修改：0.02 → 0.1（注 1 PV 约 15 s，0.1 s 一次仍有 150 帧/PV）
PARTICLE_DUMP_INTERVAL_S=0.1

# 每隔多久打印一次日志 [秒]
LOG_INTERVAL_S=0.02

# 细粒最小直径 [μm]：小于这个尺寸的颗粒当"已产出"删掉
MIN_WEAK_DIAMETER_UM=50

# 是否允许低分辨率测试（0=不允许，分辨率不够直接报错）
ALLOW_LOW_RESOLUTION_TEST=0

# Smagorinsky 湍流模型常数。0=不开湍流模型（这个尺度不需要湍流）
SMAGORINSKY_CONSTANT=0

# ── 渗透率收敛判断（标定用）：渗透率变化小于 0.2% 且持续 0.01 秒就算稳定了 ──
K_STEADY_REL_TOL=0.002
K_STEADY_WINDOW_S=0.010
K_STEADY_HOLD_S=0.003

# 时间步长安全系数（自动选 Δt 时留的余量）
MIN_TIME_SAFETY_FACTOR=1.10

# ★★ 2026-10-25 更正注释并改值：0.95 → 0.2。
#   含义：启动前用达西定律预测"入口比出口高出的格子总密度 Δρ"（LBM 里压力就是密度，p = ρ/3），
#   超过这个值就不让算。它不是"失稳报警"，而是保证物理正确的前提：
#   Shan-Chen 的分相强度取决于 G×ρ_总，出口 ρ_总=1、入口 1+Δρ，Δρ 太大时界面张力沿岩心变化，
#   G×ρ_总 > 3.4（G=2.5 时 Δρ>0.36）会发散。推荐 0.1–0.2；程序允许的最大值是 0.35。
#   想注得更快请看 修改说明_20261025.md 第 4 问，不要放宽这个值。
MAX_PREDICTED_LB_DENSITY_DROP=0.2

# ★★ 2026-10-25 新增：运行中实测"入口−出口格子密度差"的上限。超过就停算并写出最后一帧 VTK。
#   预检用的是渗透率下限 K_MIN_MD 的估计；如果实际渗透率更低或者筛网被细粒堵住，压差会比预检大。
MAX_RUNTIME_LB_DENSITY_RISE=0.35

# 一颗颗粒至少要被几格网格分辨（少于 5 格说明分辨率不够）
MIN_PARTICLE_RESOLUTION_CELLS=5

# LBM 入口速度提示范围 [格子单位]：只用于启动时打印 [WARN]，不会停算。
#   ★★ 2026-10-25 修改：MIN 1e-4 → 1e-5。V_INF=4.5e-5 m/s 时入口格子速度约 1.5e-5（双精度下没问题）。
MIN_LB_VELOCITY=1e-5
MAX_LB_VELOCITY=0.1

# LBM 包络层宽度（固体边界周围多留一层格做插值）
LBM_ENVELOPE_WIDTH=1

# 出口附近排除几层格不做 IBM 力计算（避免出口边界附近数值噪声）
IBM_OUTLET_EXCLUDED_LAYERS=2
# ★★ 2026-10-26 新增：排错开关。N>0 时前 N 步每步扫描全场，把可疑格点（总密度偏离 1 超过 12%、负密度、
#   速度过大、NaN）按位置分类（侧壁旁/入口/出口/颗粒表面/颗粒内部/孔隙中间）打印成 [DIAG] 行。
#   正常计算保持 0；只有"一开始就发散"时才设成 5～10 看看最先出问题的是哪里。
DIAGNOSTIC_SCAN_STEPS=0

# 压力边界层厚度 [格]
PRESSURE_PLANE_THICKNESS_CELLS=3

# 筛网附近压力修正的半宽 [格]
SCREEN_PRESSURE_HALF_WIDTH_CELLS=1


# ────────────────────────────────────────────────────────────────────────────
# 第 5 段：DEM 接触参数与计算保护
# ────────────────────────────────────────────────────────────────────────────

# ── 邻居表参数（颗粒碰撞检测用，一般不用动）──
# 邻居表皮层厚度 [m]：颗粒距离小于 接触距离+皮层 时登记为邻居
DEM_NEIGHBOR_SKIN_M=1e-5
# 延迟多少步才开始建邻居表（0=一开始就建）
DEM_NEIGHBOR_DELAY_STEPS=0
# 每隔多少步更新一次邻居表
DEM_NEIGHBOR_EVERY_STEPS=1
# 单颗粒最多邻居数
DEM_NEIGHBOR_ONE=10000
# 邻居表每页容量
DEM_NEIGHBOR_PAGE=1000000

# ★ 颗粒材料性质：杨氏模量 [Pa]。5e6 Pa = 5 MPa，砂岩颗粒的典型值
DEM_YOUNGS_MODULUS_PA=5e6
# 泊松比（材料横向变形率），0.25 是岩石典型值
DEM_POISSON_RATIO=0.25
# 恢复系数（碰撞后回弹能量保留比例）：0.3 = 碰撞损失70%能量
DEM_RESTITUTION=0.3
# 摩擦系数：0.5 = 中等摩擦
DEM_FRICTION=0.5

# 颗粒最大平动速度限制 [m/s]。0=按 PARTICLE_MACH_LIMIT 自动算
DEM_MAX_PARTICLE_SPEED_M_S=0
# 颗粒最大转动角速度 [rad/s]。2000 rad/s ≈ 318 转/秒
DEM_MAX_PARTICLE_OMEGA_RAD_S=2000

# ── 力超限保护：流体力超过这个值就中止运行（说明出 bug 了）──
# 单颗粒最大允许流体力 [N]
IBM_FORCE_ABORT_N=1e-4
# 单颗粒最大允许流体力矩 [N·m]
IBM_TORQUE_ABORT_NM=5e-9

# 每隔多少 DEM 步算一次颗粒动能（监控用）
DEM_THERMO_EVERY=1000

# 每隔多少个 LBM 步清理一次已产出颗粒
PARTICLE_CLEANUP_INTERVAL_LB_STEPS=3


# ────────────────────────────────────────────────────────────────────────────
# 第 6 段：出口筛网几何与性质
# ────────────────────────────────────────────────────────────────────────────

# 筛网位置 [m]：在 x=2.15 mm 处
SCREEN_X_M=2.15e-3
# 筛网丝直径 [μm]：30 μm 细钢丝
SCREEN_WIRE_DIAMETER_UM=30
# 筛网丝数量：13 根（排成一排）
SCREEN_WIRE_COUNT=13
# 筛网捕获带宽 [m]：颗粒中心进入这个范围就算被筛网拦住
SCREEN_CAPTURE_BAND_M=1.0e-4
# 筛网附近压力修正偏移量 [m]
SCREEN_PRESSURE_OFFSET_M=4.0e-5
# 颗粒被桥堵后静止的速度阈值 [m/s]：低于这个速度就算堵死了
SCREEN_BLOCKED_SPEED_M_S=2e-4

# 筛网材料性质（钢丝比颗粒硬一点）
SCREEN_YOUNGS_MODULUS_PA=5e6
SCREEN_POISSON_RATIO=0.30
SCREEN_RESTITUTION=0.20
SCREEN_FRICTION=0.60

# 筛网标定状态（注释：几何搭好了但还没跟真实筛网实验对比过）
SCREEN_CALIBRATION_STATUS=geometric_baseline_unvalidated


# ────────────────────────────────────────────────────────────────────────────
# 第 7 段：胶结键（平行键 / parallel bond）—— 出砂的核心
# ────────────────────────────────────────────────────────────────────────────
# 什么是胶结键？type1 骨架颗粒和 type2 细粒之间本来是"焊死"的。
# 流体冲这个键，应力超过键强度，键就断了，细粒就脱落开始运移 = 出砂。

# 键半径放大系数：键半径 = 系数 × 小颗粒半径。1.0 = 刚好相切
BOND_RADIUS_MULTIPLIER=1.0
# 键的等效模量 [GPa]。0.6 GPa = 600 MPa
BOND_PFC_EFFECTIVE_MODULUS_GPA=0.6
# 键的剪切模量 [GPa]
BOND_PFC_SHEAR_MODULUS_GPA=0.25
# 键法向/切向刚度比。0 = 自动按模量算
BOND_PFC_STIFFNESS_RATIO=0

# ★★ 键强度（最关键的出砂参数！）★★
# 原版 60 MPa 太硬了，流体根本冲不断，永远不出砂。
# 现在改成 0.002 MPa（细粒尺度），键破坏力和毛细力量级差不多。
# ⚠️ 这个值还没标定！需要用临界流速实验反演。
# 抗拉强度 [MPa]：拉应力超过这个就断
BOND_NORMAL_STRENGTH_MPA=0.002
# 抗剪强度 [MPa]：剪应力超过这个就断
BOND_SHEAR_STRENGTH_MPA=0.0024

# 键的阻尼系数（抑制振动，一般=0用默认）
BOND_DAMP_NORMAL_FORCE=0
BOND_DAMP_TANGENTIAL_FORCE=0
BOND_DAMP_NORMAL_TORQUE=0
BOND_DAMP_TANGENTIAL_TORQUE=0

# 建键距离阈值：颗粒中心距小于这个 [m] 才自动成键（初始相切的才成键）
BOND_CREATE_DISTANCE_M=2.25e-4
# 建键的归一化距离阈值：r/(r1+r2) < 1.00001 才算相切（精确挑出初始接触对）
BOND_CREATE_RATIO=1.00001

# DEM 全局粘性阻尼系数
DEM_VISCOUS_DAMPING=2e-8

# 键强标定状态（注释：只是把量级拉对了，还没实验标定）
BOND_CALIBRATION_STATUS=particle_scale_order_of_magnitude_unvalidated
# 是否有可用的实验标定数据（0=没有）
EXPERIMENTAL_CALIBRATION_AVAILABLE=0


# ────────────────────────────────────────────────────────────────────────────
# 第 8 段：后处理判定阈值
# ────────────────────────────────────────────────────────────────────────────

# 颗粒速度超过这个 [m/s] 才算"在动"
POST_V_MOVE_M_S=1e-3
# 颗粒速度低于这个 [m/s] 就算"停了/堵了"
POST_V_STALL_M_S=2e-4
# 连续多少帧速度都低于阈值才算真的停了（避免瞬时速度波动误判）
POST_STALL_FRAMES=5
# DEM 步长自动回退值（出问题时用）
POST_DT_DEM_FALLBACK_S=auto


# ────────────────────────────────────────────────────────────────────────────
# 第 9 段：单相渗透率标定剖面（CALIBRATION_MODE=1 时用）
# ────────────────────────────────────────────────────────────────────────────

# 标定时的网格数（一般用 N=40 粗网格快速算）
CALIBRATION_N=40
# 标定时的格子速度上限
CALIBRATION_UMAX=0.0001
# 标定时的入口速度 [m/s]（很慢，确保层流）
CALIBRATION_V_INF=0.0001
# 标定总时间 [s]
CALIBRATION_MAX_T=0.90
# 标定缓启动时间 [s]
CALIBRATION_RAMP_TIME=0.015


# ────────────────────────────────────────────────────────────────────────────
# 第 10 段：颗粒包生成参数（make_water_fangsha_pack.py 建颗粒用，不用改）
# ────────────────────────────────────────────────────────────────────────────

# 随机数种子（保证每次生成的颗粒包一样）
PACK_RANDOM_SEED=52024

# ── 骨架颗粒（type1，固定不动）的尺寸分布 ──
# 骨架颗粒最小直径 [mm]
SKELETON_DIAMETER_MIN_MM=0.20
# 骨架颗粒最大直径 [mm]
SKELETON_DIAMETER_MAX_MM=0.40
# 骨架颗粒平均直径 [mm]
SKELETON_DIAMETER_MEAN_MM=0.30
# 骨架颗粒直径标准差
SKELETON_DIAMETER_SIGMA_MM=0.04
# 骨架颗粒密度 [kg/m³]（石英）
SKELETON_DENSITY_KG_M3=2700

# ── 可动细粒（type2，会被冲走的）──
# 细粒直径 [μm]
FINE_DIAMETER_UM=50
# 细粒密度 [kg/m³]（和骨架一样，都是石英）
FINE_DENSITY_KG_M3=2700
# 细粒质量占比
FINE_FRACTION=0.02

# 骨架颗粒之间最大允许重叠比例（生成颗粒包时允许一点重叠方便压实）
SKELETON_MAX_OVERLAP_FRACTION=0.30
# 颗粒排列的基础晶格间距 [mm]
PACK_LATTICE_A_MM=0.36

# ── 筛网丝（type3）材料 ──
# 筛网丝材料：钢的密度 [kg/m³]
SCREEN_DENSITY_KG_M3=7800

# 筛网孔径校验参数
SCREEN_VALIDATION_SPACING_UM=2.5
SCREEN_MIN_APERTURE_RATIO=1.10
SCREEN_MAX_APERTURE_RATIO=1.80

# 细粒浓度范围（校验颗粒包是否合理）
FINE_CONCENTRATION_MIN=0.015
FINE_CONCENTRATION_MAX=0.025

# 建键时的接触距离容差 [m]
BOND_CONTACT_TOLERANCE=1.0e-5
# 键审计输出文件路径
BOND_AUDIT_DEFAULT_OUTPUT=data/parallel_bond_audit.csv


# ────────────────────────────────────────────────────────────────────────────
# 第 11 段：可视化输出选项（一般不用改）
# ────────────────────────────────────────────────────────────────────────────

# VTK 文件名数字位数
VTK_FILE_DIGITS=6
# GIF 图片尺寸 [像素]
GIF_IMAGE_SIZE_PX=600
# GIF 速度色条范围 [m/s]
GIF_VELOCITY_MIN_M_S=0
GIF_VELOCITY_MAX_M_S=0.02
# 出口后处理区域半长 [m]
POST_OUTLET_HALF_M=3.0e-4


# ────────────────────────────────────────────────────────────────────────────
# 第 12 段：程序自检容差（机器验证用，不是物理参数，不要改）
# ────────────────────────────────────────────────────────────────────────────

VALIDATION_PV_REL_TOL=1.0e-9
VALIDATION_FORCE_LIMIT_FACTOR=1.00001
VALIDATION_MAX_LB_VELOCITY=0.35
VALIDATION_MIN_MEAN_DENSITY=0.5
VALIDATION_MAX_MEAN_DENSITY=1.5
VALIDATION_PARTICLE_COUNT_TOL=0.1
VALIDATION_BOND_COUNT_TOL=0.1
