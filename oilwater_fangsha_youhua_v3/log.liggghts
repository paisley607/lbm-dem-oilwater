# =============================================================================
# in.lbdem —— LIGGGHTS 第一段输入脚本：建立 DEM 颗粒体系（几何、材料、胶结、耦合、壁面）
#
# 【什么时候执行】主程序 oilwaterDrive.cpp 在完成单位换算后、建 LBM 格子之前，
#   调用 wrapper.execFile("in.lbdem") 执行本文件（见 oilwaterDrive.cpp 第 3 步）。
#   之后 C++ 再执行 in2.lbdem 设定积分器和输出，然后进入主循环。
# 【三类颗粒】type 1 = 固定骨架颗粒（不动）；type 2 = 弱胶结细粒（可脱落、运移、产出）；
#   type 3 = 出口筛网丝（固定，用来拦砂）。
# 【${...} 变量】所有 ${xxx} 都不是在这里定义的，而是 C++ 通过 wrapper.setVariable("xxx", 值)
#   传进来的，数值最终来自 config/defaults.env（或实验 .env 覆盖）。
# 【阅读提示】LIGGGHTS 命令格式是 "命令 参数..."；fix 是"持续生效的设置/操作"，
#   property/global 是"全局材料属性表"，peratomtype 按颗粒类型给值，peratomtypepair 按类型对给值
#   （3 类颗粒 → 3×3=9 个数，顺序是 11 12 13 21 22 23 31 32 33）。
# =============================================================================

echo both                                                              # 命令和结果同时打印到屏幕和日志，便于排错
log ${dmp_dir}/${output_prefix}log.liggghts                              # DEM 日志放进本次运行的输出目录，文件名带实验名前缀
log /public3/home/sc52079/LBDEM_runs/oilwater_1pv_m2_n20_v2/post//${output_prefix}log.liggghts                              
